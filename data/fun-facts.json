  "facts": [
    {
      "id": "depauw-founding",
      "school": "depauw",
      "text": "DePauw began in 1837 as Indiana Asbury University, named in honor of Francis Asbury.",
      "sources": [{"label": "DePauw: History & Traditions", "url": "https://www.depauw.edu/about/history-traditions/"}]
    },
    {
      "id": "depauw-women-1867",
      "school": "depauw",
      "text": "DePauw admitted a small group of women in 1867.",
      "sources": [
        {"label": "DePauw: History & Traditions", "url": "https://www.depauw.edu/about/history-traditions/"},
        {"label": "DePauw catalog: The University", "url": "https://www.depauw.edu/academics/catalog/university/"}
      ]
    },
    {
      "id": "depauw-theta",
      "school": "depauw",
      "text": "Kappa Alpha Theta was founded at DePauw (then Indiana Asbury) on Jan 27, 1870. DePauw calls it the first sorority in the nation.",
      "sources": [
        {"label": "DePauw: Kappa Alpha Theta", "url": "https://www.depauw.edu/campus-life/greek/councilschapters/depauwchapters/kappaalphatheta/"},
        {"label": "DePauw: History & Traditions", "url": "https://www.depauw.edu/about/history-traditions/"}
      ]
    },
    {
      "id": "depauw-rector",
      "school": "depauw",
      "text": "The Rector Scholarship, begun in 1919, is DePauw’s oldest merit academic award.",
      "sources": [{"label": "DePauw: History & Traditions", "url": "https://www.depauw.edu/about/history-traditions/"}]
    },
    {
      "id": "depauw-nature-park",
      "school": "depauw",
      "text": "DePauw’s nature park covers 520 acres, one-third of a mile west of campus.",
      "sources": [{"label": "DePauw catalog: The University", "url": "https://www.depauw.edu/academics/catalog/university/"}]
    },
    {
      "id": "depauw-phi-beta-kappa",
      "school": "depauw",
      "text": "Indiana’s first Phi Beta Kappa chapter is at DePauw.",
      "sources": [
        {"label": "DePauw: History & Traditions", "url": "https://www.depauw.edu/about/history-traditions/"},
        {"label": "DePauw catalog: The University", "url": "https://www.depauw.edu/academics/catalog/university/"}
      ]
    },
    {
      "id": "depauw-wgre",
      "school": "depauw",
      "text": "DePauw’s radio station, WGRE, was the first collegiate FM station in the country, on the air in 1949.",
      "sources": [{"label": "DePauw: History & Traditions", "url": "https://www.depauw.edu/about/history-traditions/"}]
    },
    {
      "id": "depauw-boulder",
      "school": "depauw",
      "text": "A massive granite boulder, given to DePauw in 1892, sits in front of East College.",
      "sources": [{"label": "DePauw: History & Traditions", "url": "https://www.depauw.edu/about/history-traditions/"}]
    },
    {
      "id": "depauw-winter-term",
      "school": "depauw",
      "text": "Every January, DePauw students take part in Winter Term, a four-week immersive experience.",
      "sources": [{"label": "DePauw: FAQ", "url": "https://www.depauw.edu/faq/"}]
    },
    {
      "id": "depauw-spj",
      "school": "depauw",
      "text": "The Society of Professional Journalists was founded on DePauw’s campus in 1909.",
      "sources": [{"label": "DePauw: History & Traditions", "url": "https://www.depauw.edu/about/history-traditions/"}]
    },
    {
      "id": "wabash-founding",
      "school": "wabash",
      "text": "Wabash was founded on Nov 21, 1832, and its founders knelt in the snow the next day to dedicate the school.",
      "sources": [{"label": "Wabash: A Brief History", "url": "https://www.wabash.edu/aboutwabash/history"}]
    },
    {
      "id": "wabash-nonsectarian",
      "school": "wabash",
      "text": "Wabash has always been independent and non-sectarian.",
      "sources": [{"label": "Wabash: A Brief History", "url": "https://www.wabash.edu/aboutwabash/history"}]
    },
    {
      "id": "wabash-caleb-mills",
      "school": "wabash",
      "text": "Wabash’s history says Caleb Mills, an early figure at the college, later became the father of the Indiana public school system.",
      "sources": [{"label": "Wabash: A Brief History", "url": "https://www.wabash.edu/aboutwabash/history"}]
    },
    {
      "id": "wabash-mills-bell",
      "school": "wabash",
      "text": "Each fall, Wabash uses Caleb Mills’ bell to ring in the freshman class, and each spring it rings out the graduating class.",
      "sources": [{"label": "Wabash: A Brief History", "url": "https://www.wabash.edu/aboutwabash/history"}]
    },
    {
      "id": "wabash-gentlemans-rule",
      "school": "wabash",
      "text": "Student conduct at Wabash is governed by the Gentleman’s Rule: behave as a gentleman and a responsible citizen.",
      "sources": [{"label": "About Wabash", "url": "https://www.wabash.edu/aboutwabash/"}]
    },
    {
      "id": "wabash-little-giants",
      "school": "wabash",
      "text": "Wabash got the nickname Little Giants in 1904, from an Indianapolis News sportswriter talking with coach Francis Cayou.",
      "sources": [{"label": "Wabash Athletics History", "url": "https://sports.wabash.edu/sports/2011/8/1/GEN_0801115020.aspx"}]
    },
    {
      "id": "wabash-always-fights",
      "school": "wabash",
      "text": "The motto “Wabash Always Fights” began at a 1919 meeting of the Montgomery County Alumni Association.",
      "sources": [{"label": "Wabash Athletics History", "url": "https://sports.wabash.edu/sports/2011/8/1/GEN_0801115020.aspx"}]
    },
    {
      "id": "wabash-old-wabash",
      "school": "wabash",
      "text": "“Old Wabash” was written in 1899, and Wabash calls it the nation’s longest fight song.",
      "sources": [
        {"label": "About Wabash", "url": "https://www.wabash.edu/aboutwabash/"},
        {"label": "Wabash Athletics History", "url": "https://sports.wabash.edu/sports/2011/8/1/GEN_0801115020.aspx"}
      ]
    },
    {
      "id": "wabash-scarlet",
      "school": "wabash",
      "text": "Scarlet became Wabash’s official school color in 1886.",
      "sources": [{"label": "Wabash Athletics History", "url": "https://sports.wabash.edu/sports/2011/8/1/GEN_0801115020.aspx"}]
    },
    {
      "id": "wabash-mission",
      "school": "wabash",
      "text": "Wabash’s mission is to educate men to think critically, act responsibly, lead effectively, and live humanely.",
      "sources": [{"label": "About Wabash", "url": "https://www.wabash.edu/aboutwabash/"}]
    },
    {
      "id": "both-locomotive-bell",
      "school": "both",
      "text": "The Monon Bell is a locomotive bell from the Monon Railroad, and it became the rivalry’s trophy in 1932.",
      "sources": [
        {"label": "DePauw Athletics: Monon Bell history", "url": "https://depauwtigers.com/sports/2022/6/28/monon-bell-history.aspx"},
        {"label": "Wabash Athletics: Monon Bell", "url": "https://sports.wabash.edu/mononbell"}
      ]
    },
    {
      "id": "both-bell-weight",
      "school": "both",
      "text": "The Monon Bell weighs about 300 pounds, though reports have put it anywhere from 200 to 400.",
      "sources": [{"label": "DePauw Athletics: Rivalry facts", "url": "https://depauwtigers.com/sports/2022/6/28/rivalry-facts.aspx"}]
    },
    {
      "id": "both-monon-line",
      "school": "both",
      "text": "The Monon Railroad line between Crawfordsville and Greencastle often carried the teams to the game.",
      "sources": [{"label": "Wabash Athletics: Monon Bell", "url": "https://sports.wabash.edu/mononbell"}]
    },
    {
      "id": "both-tie-rule",
      "school": "both",
      "text": "If the Monon Bell game ends in a tie, the team that held the Bell going in keeps it.",
      "sources": [{"label": "DePauw Athletics: Rivalry facts", "url": "https://depauwtigers.com/sports/2022/6/28/rivalry-facts.aspx"}]
    },
    {
      "id": "both-ballad",
      "school": "both",
      "text": "“The Ballad of the Monon Bell,” a song about the rivalry, was recorded in 1985.",
      "sources": [{"label": "DePauw Athletics: Monon Bell history", "url": "https://depauwtigers.com/sports/2022/6/28/monon-bell-history.aspx"}]
    }
  ]
}
